# Existing PostgreSQL volume keeps its original bootstrap database.
POSTGRES_DB=multiprint
# Backend uses this separate, newly initialized database.
APP_DB=multiprint_v2_clean
POSTGRES_USER=multiprint
POSTGRES_PASSWORD=replace-with-existing-database-password
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@multiprint.com
PGADMIN_DEFAULT_PASSWORD=replace-with-pgadmin-password
PGADMIN_PORT=5052

SERVICE_PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
SEED_INITIAL_PASSWORD=replace-with-a-unique-initial-password

UI_PORT=5173
VITE_API_BASE_URL=http://localhost:5000/api
