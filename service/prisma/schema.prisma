  master_pelanggan                                            master_pelanggan               @relation(fields: [pelanggan_id], references: [id], onUpdate: NoAction)
  pengaduan                                                   pengaduan?                     @relation(fields: [pengaduan_id], references: [id], onUpdate: NoAction)
  master_printer_terpasang                                    master_printer_terpasang?      @relation(fields: [printer_terpasang_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  teknisi_surat_tugas                                         teknisi_surat_tugas[]

  @@index([pengaduan_id, status], map: "idx_surat_tugas_pengaduan_status")
}

model teknisi_surat_tugas {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surat_tugas_id  String                    @db.Uuid
  teknisi_id      String                    @db.Uuid
  peran           peran_teknisi_surat_tugas @default(utama)
  surat_tugas     surat_tugas               @relation(fields: [surat_tugas_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  master_pengguna master_pengguna           @relation(fields: [teknisi_id], references: [id], onUpdate: NoAction)

  @@unique([surat_tugas_id, teknisi_id], map: "uq_teknisi_surat_tugas")
  @@index([teknisi_id], map: "idx_teknisi_surat_tugas_teknisi")
}

model riwayat_audit {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jenis_dokumen   String           @db.VarChar(50)
  nomor_dokumen   String           @db.VarChar(100)
  tabel_sumber    String           @db.VarChar(100)
  id_sumber       String           @db.Uuid
  aksi            String           @db.VarChar(50)
  status_sebelum  String?          @db.VarChar(50)
  status_sesudah  String?          @db.VarChar(50)
  data_sebelum    Json?
  data_sesudah    Json?
  keterangan      String?
  pengguna_id     String?          @db.Uuid
  nama_pengguna   String?          @db.VarChar(150)
  ip_address      String?          @db.VarChar(100)
  user_agent      String?
  tanggal_audit   DateTime         @default(now()) @db.Timestamptz(6)
  master_pengguna master_pengguna? @relation(fields: [pengguna_id], references: [id], onUpdate: NoAction)

  @@index([jenis_dokumen, nomor_dokumen], map: "idx_riwayat_audit_dokumen")
  @@index([tabel_sumber, id_sumber], map: "idx_riwayat_audit_sumber")
  @@index([tanggal_audit], map: "idx_riwayat_audit_tanggal")
}

